---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Manifest UI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&family=Fira+Code&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/docs.css" />
</head>
<body>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <div class="docs-sidebar__brand">
        <span class="docs-sidebar__name">manifest<span class="docs-sidebar__ui">/ui</span></span>
      </div>
      <nav class="docs-sidebar__nav">
        {nav.map(group => (
          <div class="docs-sidebar__group">
            <div class="docs-sidebar__group-label">{group.label}</div>
            <ul class="docs-sidebar__list">
              {group.items.map(item => (
                <li>
                  <a
                    href={item.href}
                    class={`docs-sidebar__link ${currentPath === item.href ? 'docs-sidebar__link--active' : ''}`}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>
    <main class="docs-main">
      <div class="docs-content">
        <slot />
      </div>
    </main>
  </div>
</body>
</html>
