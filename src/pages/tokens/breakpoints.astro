---
import DocsLayout from '../../layouts/DocsLayout.astro';
const breakpoints = [
  { name: 'xs', query: 'max-width: 480px' },
  { name: 'sm', query: 'max-width: 560px' },
  { name: 'mobile', query: 'max-width: 640px' },
  { name: 'tablet-sm', query: 'max-width: 768px' },
  { name: 'tablet-md', query: 'max-width: 820px' },
  { name: 'tablet-lg', query: 'max-width: 899px' },
  { name: 'desktop-sm', query: 'max-width: 900px' },
  { name: 'desktop-sm-min', query: 'min-width: 900px' },
  { name: 'desktop-md', query: 'max-width: 950px' },
  { name: 'desktop-lg', query: 'max-width: 1023px' },
  { name: 'tablet-range', query: 'min-width: 769px and max-width: 1024px' },
  { name: 'desktop', query: 'max-width: 1024px' },
  { name: 'desktop-xl', query: 'max-width: 1240px' },
  { name: 'desktop-2xl', query: 'max-width: 1279px' },
  { name: 'reduced-motion', query: 'prefers-reduced-motion: reduce' },
];
---
<DocsLayout title="Breakpoints">
  <h1>Breakpoints</h1>
  <p class="docs-lead">15 breakpoints used across the site. Desktop-centric with max-width approach.</p>
  <table class="docs-table">
    <thead><tr><th>Name</th><th>Media query</th></tr></thead>
    <tbody>
      {breakpoints.map(b => (
        <tr>
          <td>{b.name}</td>
          <td>@media ({b.query})</td>
        </tr>
      ))}
    </tbody>
  </table>
</DocsLayout>
