---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Discovery Modal">
  <h1>Discovery Modal <span class="docs-tag">Modals &amp; Overlays</span></h1>
  <p class="docs-lead">Offer modal extending the base modal. Has a banner image area, eyebrow label, highlighted title, feature list, primary CTA, and a terms link.</p>
  <h2>Preview</h2>
  <div class="docs-preview">
    <div style="display:flex;justify-content:center;">
      <div class="modal discovery-modal" role="dialog" style="position:static;display:block;max-width:360px;width:100%;">
        <div class="discovery-modal__banner" style="background:#dbd7d0;height:160px;"></div>
        <button class="discovery-modal__close" aria-label="Close">×</button>
        <div class="discovery-modal__body">
          <p class="discovery-modal__eyebrow">Special offer</p>
          <h2 class="discovery-modal__title">
            Unlock <span class="discovery-modal__highlight">pro</span> features
          </h2>
          <p class="discovery-modal__subtitle">Start your free trial today.</p>
          <ul class="discovery-modal__features">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Unlimited projects</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Priority support</li>
          </ul>
          <a class="discovery-modal__cta btn btn--primary" href="#">Get started</a>
          <a class="discovery-modal__terms" href="#">Terms apply</a>
        </div>
      </div>
    </div>
  </div>
  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="modal discovery-modal" role="dialog"&gt;
  &lt;div class="discovery-modal__banner"&gt;
    &lt;img class="discovery-modal__banner-img" src="banner.png" alt="" /&gt;
  &lt;/div&gt;
  &lt;button class="discovery-modal__close" aria-label="Close"&gt;&amp;times;&lt;/button&gt;
  &lt;div class="discovery-modal__body"&gt;
    &lt;p class="discovery-modal__eyebrow"&gt;Special offer&lt;/p&gt;
    &lt;h2 class="discovery-modal__title"&gt;
      Unlock &lt;span class="discovery-modal__highlight"&gt;pro&lt;/span&gt; features
    &lt;/h2&gt;
    &lt;p class="discovery-modal__subtitle"&gt;Start your free trial today.&lt;/p&gt;
    &lt;ul class="discovery-modal__features"&gt;
      &lt;li&gt;&lt;svg&gt;...&lt;/svg&gt; Unlimited projects&lt;/li&gt;
      &lt;li&gt;&lt;svg&gt;...&lt;/svg&gt; Priority support&lt;/li&gt;
    &lt;/ul&gt;
    &lt;a class="discovery-modal__cta btn btn--primary" href="#"&gt;Get started&lt;/a&gt;
    &lt;a class="discovery-modal__terms" href="#"&gt;Terms apply&lt;/a&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>
  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.discovery-modal</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root container. Used alongside .modal.</td></tr>
      <tr><td>.discovery-modal__banner</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Banner image wrapper at the top of the modal.</td></tr>
      <tr><td>.discovery-modal__banner-img</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Banner image; full width, object-fit cover.</td></tr>
      <tr><td>.discovery-modal__close</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Close button; absolute top-right.</td></tr>
      <tr><td>.discovery-modal__body</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Content area below the banner.</td></tr>
      <tr><td>.discovery-modal__eyebrow</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Small label above the title.</td></tr>
      <tr><td>.discovery-modal__eyebrow[hidden]</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hides the eyebrow label.</td></tr>
      <tr><td>.discovery-modal__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Main modal heading.</td></tr>
      <tr><td>.discovery-modal__highlight</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Highlighted text span inside the title.</td></tr>
      <tr><td>.discovery-modal__title-logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Optional inline logo image inside the title.</td></tr>
      <tr><td>.discovery-modal__subtitle</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Subtitle below the title.</td></tr>
      <tr><td>.discovery-modal__features</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Feature list with icon per item.</td></tr>
      <tr><td>.discovery-modal__cta</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Primary CTA link; use alongside .btn.btn--primary.</td></tr>
      <tr><td>.discovery-modal__terms</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Terms link below the CTA; muted color.</td></tr>
    </tbody>
  </table>
</DocsLayout>
