---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Section Header">
  <h1>Section Header <span class="docs-tag">Layout</span></h1>
  <p class="docs-lead">Section header used to group providers by category. Contains a title and an optional subtitle capped at 62ch.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="providers-section__head">
      <h2 class="providers-section__title">Open-source models</h2>
      <p class="providers-section__subtitle">Providers that expose open-weight models via a standard API.</p>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="providers-section__head"&gt;
  &lt;h2 class="providers-section__title"&gt;Open-source models&lt;/h2&gt;
  &lt;p class="providers-section__subtitle"&gt;Providers that expose open-weight models via a standard API.&lt;/p&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.providers-section__head</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Section header wrapper; adds bottom margin</td></tr>
      <tr><td>.providers-section__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Display-font heading at --size-2xl weight 800</td></tr>
      <tr><td>.providers-section__subtitle</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted description capped at 62ch</td></tr>
    </tbody>
  </table>
</DocsLayout>
