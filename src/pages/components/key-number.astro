---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Key Number">
  <h1>Key Number <span class="docs-tag">Sections</span></h1>
  <p class="docs-lead">Large stat display with a label and a prominent number value.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="key-number">
      <span class="key-number__label">Requests routed</span>
      <span class="key-number__value">7.7M</span>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;div class="key-number"&gt;
  &lt;span class="key-number__label"&gt;Requests routed&lt;/span&gt;
  &lt;span class="key-number__value"&gt;7.7M&lt;/span&gt;
&lt;/div&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.key-number</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Stat block container</td></tr>
      <tr><td>.key-number__label</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Descriptive label above or below the number</td></tr>
      <tr><td>.key-number__value</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">The prominent numeric value</td></tr>
    </tbody>
  </table>
</DocsLayout>
