---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Prefooter Stat">
  <h1>Prefooter Stat <span class="docs-tag">Sections</span></h1>
  <p class="docs-lead">Pre-footer stat block with a large number and supporting inner content.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="prefooter-stat">
      <div class="prefooter-stat__inner">
        <span class="prefooter-stat__num">81k+</span>
        Docker pulls
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;div class="prefooter-stat"&gt;
  &lt;div class="prefooter-stat__inner"&gt;
    &lt;span class="prefooter-stat__num"&gt;81k+&lt;/span&gt;
    Docker pulls
  &lt;/div&gt;
&lt;/div&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.prefooter-stat</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Outer stat block wrapper</td></tr>
      <tr><td>.prefooter-stat__inner</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Inner container holding the number and label</td></tr>
      <tr><td>.prefooter-stat__num</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Large numeric value</td></tr>
    </tbody>
  </table>
</DocsLayout>
