---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Error Crosslink">
  <h1>Error Crosslink <span class="docs-tag">Other</span></h1>
  <p class="docs-lead">Cross-link card used on error pages. Shows logo, title, subtitle, and arrow.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    <link rel="stylesheet" href="/styles/manifest.css" />
    <a class="err-crosslink" href="/providers">
      <img class="err-crosslink__logo" src="https://placehold.co/40x40" alt="" />
      <div class="err-crosslink__text">
        <span class="err-crosslink__title">Browse providers</span>
        <span class="err-crosslink__sub">31 LLM providers available</span>
      </div>
      <span class="err-crosslink__arrow">→</span>
    </a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;a class="err-crosslink" href="/providers"&gt;
  &lt;img class="err-crosslink__logo" src="..." alt="" /&gt;
  &lt;div class="err-crosslink__text"&gt;
    &lt;span class="err-crosslink__title"&gt;Browse providers&lt;/span&gt;
    &lt;span class="err-crosslink__sub"&gt;31 LLM providers available&lt;/span&gt;
  &lt;/div&gt;
  &lt;span class="err-crosslink__arrow"&gt;→&lt;/span&gt;
&lt;/a&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.err-crosslink</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Card link container</td></tr>
      <tr><td>.err-crosslink:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover state of the card</td></tr>
      <tr><td>.err-crosslink:focus-visible</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Keyboard focus state of the card</td></tr>
      <tr><td>.err-crosslink__logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Logo image</td></tr>
      <tr><td>.err-crosslink__text</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Wrapper for title and subtitle</td></tr>
      <tr><td>.err-crosslink__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Primary label of the crosslink</td></tr>
      <tr><td>.err-crosslink__sub</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Supporting subtitle text</td></tr>
      <tr><td>.err-crosslink__arrow</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Arrow indicator on the right side</td></tr>
    </tbody>
  </table>
</DocsLayout>
