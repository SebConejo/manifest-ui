---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Pricing OSS">
  <h1>Pricing OSS <span class="docs-tag">Pricing</span></h1>
  <p class="docs-lead">Horizontal open-source banner card. Sits between pricing cards and the comparison table; collapses to a stacked layout on mobile.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="pricing-oss">
      <div class="pricing-oss__content">
        <div>
          <div class="pricing-oss__header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.607.069-.607 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.579.688.481C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
            <span class="pricing-oss__title">Open source</span>
            <span class="pricing-oss__license">MIT</span>
          </div>
          <p class="pricing-oss__desc">Manifest is fully open source under the MIT license. Self-host it for free, audit the code, and contribute.</p>
        </div>
        <div class="pricing-oss__actions">
          <a href="#" class="btn btn--secondary">View on GitHub</a>
          <a href="#" class="btn btn--primary">Get started</a>
        </div>
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="pricing-oss"&gt;
  &lt;div class="pricing-oss__content"&gt;
    &lt;div&gt;
      &lt;div class="pricing-oss__header"&gt;
        &lt;svg&gt;…&lt;/svg&gt;
        &lt;span class="pricing-oss__title"&gt;Open source&lt;/span&gt;
        &lt;span class="pricing-oss__license"&gt;MIT&lt;/span&gt;
      &lt;/div&gt;
      &lt;p class="pricing-oss__desc"&gt;Manifest is fully open source under the MIT license.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div class="pricing-oss__actions"&gt;
      &lt;a href="#" class="btn btn--secondary"&gt;View on GitHub&lt;/a&gt;
      &lt;a href="#" class="btn btn--primary"&gt;Get started&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.pricing-oss</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root element; borderless horizontal card with bottom border only</td></tr>
      <tr><td>.pricing-oss__content</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row; space-between layout for text and actions</td></tr>
      <tr><td>.pricing-oss__header</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row containing the icon, title, and license badge</td></tr>
      <tr><td>.pricing-oss__header svg</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Icon inheriting text color; flex-shrink 0</td></tr>
      <tr><td>.pricing-oss__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Display-font heading at <code>--size-xl</code>, weight 700</td></tr>
      <tr><td>.pricing-oss__license</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Pill badge (white on dark); 9px uppercase, letter-spacing 0.08em</td></tr>
      <tr><td>.pricing-oss__desc</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted description text; max-width 600px</td></tr>
      <tr><td>.pricing-oss__actions</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row of CTA buttons; flex-shrink 0</td></tr>
      <tr><td>.pricing-oss__content (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">&lt;768px: column layout, left-aligned</td></tr>
      <tr><td>.pricing-oss__actions (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">&lt;768px: full width</td></tr>
      <tr><td>.pricing-oss__actions .btn (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">&lt;768px: buttons flex to equal width, centered</td></tr>
    </tbody>
  </table>
</DocsLayout>
