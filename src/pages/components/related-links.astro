---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Related Links">
  <h1>Related Links <span class="docs-tag">Other</span></h1>
  <p class="docs-lead">Section of related links in a grid layout, with title and individual link items.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="related-links">
      <h3 class="related-links__title">Related providers</h3>
      <div class="related-links__grid">
        <a class="related-links__link" href="#">Anthropic</a>
        <a class="related-links__link" href="#">Google</a>
        <a class="related-links__link" href="#">Mistral</a>
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;div class="related-links"&gt;
  &lt;h3 class="related-links__title"&gt;Related providers&lt;/h3&gt;
  &lt;div class="related-links__grid"&gt;
    &lt;a class="related-links__link" href="#"&gt;Anthropic&lt;/a&gt;
    &lt;a class="related-links__link" href="#"&gt;Google&lt;/a&gt;
    &lt;a class="related-links__link" href="#"&gt;Mistral&lt;/a&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.related-links</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Section wrapper</td></tr>
      <tr><td>.related-links__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Section heading</td></tr>
      <tr><td>.related-links__list</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">List container variant</td></tr>
      <tr><td>.related-links__grid</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Grid layout container for links</td></tr>
      <tr><td>.related-links__link</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual link item</td></tr>
      <tr><td>.related-links__link:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover state of a link</td></tr>
    </tbody>
  </table>
</DocsLayout>
