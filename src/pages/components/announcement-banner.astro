---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Announcement Banner">
  <h1>Announcement Banner <span class="docs-tag">Global</span></h1>
  <p class="docs-lead">Full-width announcement strip at the very top of the page, above the nav. Contains an animated canvas background.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="announcement-banner">
      <canvas></canvas>
      <span class="announcement-banner__badge">New</span>
      <span class="announcement-banner__text">Announcement text</span>
      <a class="announcement-banner__btn" href="#">
        Learn more
        <i class="announcement-banner__arrow"></i>
      </a>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="announcement-banner"&gt;
  &lt;canvas&gt;&lt;/canvas&gt;
  &lt;span class="announcement-banner__badge"&gt;New&lt;/span&gt;
  &lt;span class="announcement-banner__text"&gt;Announcement text&lt;/span&gt;
  &lt;a class="announcement-banner__btn" href="#"&gt;
    Learn more
    &lt;i class="announcement-banner__arrow"&gt;&lt;/i&gt;
  &lt;/a&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.announcement-banner</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root strip element</td></tr>
      <tr><td>.announcement-banner canvas</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Animated canvas background</td></tr>
      <tr><td>.announcement-banner__badge</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Pill label (e.g. "New")</td></tr>
      <tr><td>.announcement-banner__text</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Main announcement copy</td></tr>
      <tr><td>.announcement-banner__cta</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">CTA wrapper (optional outer link)</td></tr>
      <tr><td>.announcement-banner__btn</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Action link button</td></tr>
      <tr><td>.announcement-banner__btn:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover style on the button</td></tr>
      <tr><td>.announcement-banner__arrow</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Arrow icon inside the button</td></tr>
      <tr><td>.announcement-banner:hover .announcement-banner__arrow</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Arrow shift on banner hover</td></tr>
    </tbody>
  </table>
</DocsLayout>
