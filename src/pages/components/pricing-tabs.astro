---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Pricing Tabs">
  <h1>Pricing Tabs <span class="docs-tag">Pricing</span></h1>
  <p class="docs-lead">Segmented control for switching between billing periods (monthly/yearly).</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    <link rel="stylesheet" href="/styles/manifest.css" />
    <div class="pricing-tabs">
      <button class="pricing-tabs__tab pricing-tabs__tab--active">Monthly</button>
      <button class="pricing-tabs__tab">Yearly</button>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="pricing-tabs"&gt;
  &lt;button class="pricing-tabs__tab pricing-tabs__tab--active"&gt;Monthly&lt;/button&gt;
  &lt;button class="pricing-tabs__tab"&gt;Yearly&lt;/button&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.pricing-tabs</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Segmented control wrapper</td></tr>
      <tr><td>.pricing-tabs__tab</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual period button</td></tr>
      <tr><td>.pricing-tabs__tab--active</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Selected period state</td></tr>
      <tr><td>.pricing-tabs__tab:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover style on inactive tab</td></tr>
    </tbody>
  </table>
</DocsLayout>
