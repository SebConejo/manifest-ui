---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Agent Category Pill">
  <h1>Agent Category Pill <span class="docs-tag">Agents</span></h1>
  <p class="docs-lead">Color-coded pill tag for agent categories. Three variants: personal (teal), app (amber), coding (purple).</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <span class="agent-category-pill agent-category-pill--personal">Personal</span>
    <span class="agent-category-pill agent-category-pill--app">App</span>
    <span class="agent-category-pill agent-category-pill--coding">Coding</span>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;span class="agent-category-pill agent-category-pill--personal"&gt;Personal&lt;/span&gt;
&lt;span class="agent-category-pill agent-category-pill--app"&gt;App&lt;/span&gt;
&lt;span class="agent-category-pill agent-category-pill--coding"&gt;Coding&lt;/span&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.agent-category-pill</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Pill root element</td></tr>
      <tr><td>.agent-category-pill--personal</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Teal variant for the Personal category</td></tr>
      <tr><td>.agent-category-pill--app</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Amber variant for the App category</td></tr>
      <tr><td>.agent-category-pill--coding</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Purple variant for the Coding category</td></tr>
    </tbody>
  </table>
</DocsLayout>
