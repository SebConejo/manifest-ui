---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Feature Tabs">
  <h1>Feature Tabs <span class="docs-tag">Tabs &amp; Accordions</span></h1>
  <p class="docs-lead">Horizontal tabs switching between feature panels. Each panel has a text area and a visual/screenshot.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="feature-tabs-wrapper">
      <div class="feature-tabs">
        <nav class="feature-tabs__nav">
          <button class="feature-tabs__tab feature-tabs__tab--active">
            <span class="feature-tabs__label">Routing</span>
          </button>
          <button class="feature-tabs__tab">
            <span class="feature-tabs__label">Fallback</span>
          </button>
        </nav>
        <div class="feature-tabs__panels">
          <div class="feature-tabs__panel feature-tabs__panel--active">
            <div class="feature-tabs__text">
              <h3 class="feature-tabs__title">Smart routing</h3>
              <p>Description text</p>
            </div>
            <div class="feature-tabs__visual">
              <img src="https://placehold.co/480x320/fcfaf5/2c2418?text=Visual" alt="Feature visual" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="feature-tabs-wrapper"&gt;
  &lt;div class="feature-tabs"&gt;
    &lt;nav class="feature-tabs__nav"&gt;
      &lt;button class="feature-tabs__tab feature-tabs__tab--active"&gt;
        &lt;span class="feature-tabs__label"&gt;Routing&lt;/span&gt;
      &lt;/button&gt;
      &lt;button class="feature-tabs__tab"&gt;
        &lt;span class="feature-tabs__label"&gt;Fallback&lt;/span&gt;
      &lt;/button&gt;
    &lt;/nav&gt;
    &lt;div class="feature-tabs__panels"&gt;
      &lt;div class="feature-tabs__panel feature-tabs__panel--active"&gt;
        &lt;div class="feature-tabs__text"&gt;
          &lt;h3 class="feature-tabs__title"&gt;Smart routing&lt;/h3&gt;
          &lt;p&gt;Description text&lt;/p&gt;
        &lt;/div&gt;
        &lt;div class="feature-tabs__visual"&gt;
          &lt;img src="..." alt="Feature visual" /&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.feature-tabs</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Tab component root</td></tr>
      <tr><td>.feature-tabs-wrapper</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Outer layout wrapper</td></tr>
      <tr><td>.feature-tabs-wrapper__video</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Optional video element inside the wrapper</td></tr>
      <tr><td>.feature-tabs__nav</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Tab navigation bar</td></tr>
      <tr><td>.feature-tabs__tab</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual tab button</td></tr>
      <tr><td>.feature-tabs__tab--active</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Active state for a tab button</td></tr>
      <tr><td>.feature-tabs__panels</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Panels container</td></tr>
      <tr><td>.feature-tabs__panel</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual panel</td></tr>
      <tr><td>.feature-tabs__panel--active</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Active state for a panel</td></tr>
      <tr><td>.feature-tabs__text</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Text content area of a panel</td></tr>
      <tr><td>.feature-tabs__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Panel heading</td></tr>
      <tr><td>.feature-tabs__visual</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Visual/screenshot area of a panel</td></tr>
      <tr><td>.feature-tabs__label</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Label text inside a tab button</td></tr>
    </tbody>
  </table>
</DocsLayout>
