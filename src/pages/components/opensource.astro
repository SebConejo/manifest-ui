---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Open Source">
  <h1>Open Source <span class="docs-tag">Sections</span></h1>
  <p class="docs-lead">Open source stats section with decorative corner elements, stat cards, links, and a provider logo strip.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="opensource__grid">
      <div class="opensource__corner opensource__corner--tl"></div>
      <div class="opensource__corner opensource__corner--tr"></div>
      <div class="opensource__card">
        <div class="opensource__stat">
          <svg></svg>
          <span class="opensource__metric">7,340</span>
          <span class="opensource__dot"></span>
        </div>
        <h3 class="opensource__card-title">GitHub stars</h3>
        <p class="opensource__card-text">And growing every day.</p>
      </div>
      <div class="opensource__links">
        <a class="opensource__link" href="#">
          <i class="bx bx-git-branch"></i> View on GitHub
        </a>
      </div>
      <div class="opensource__providers">
        <div class="opensource__providers-track">
          <img class="opensource__provider-logo" src="..." alt="" />
        </div>
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="opensource__grid"&gt;
  &lt;div class="opensource__corner opensource__corner--tl"&gt;&lt;/div&gt;
  &lt;div class="opensource__corner opensource__corner--tr"&gt;&lt;/div&gt;
  &lt;div class="opensource__card"&gt;
    &lt;div class="opensource__stat"&gt;
      &lt;svg&gt;...&lt;/svg&gt;
      &lt;span class="opensource__metric"&gt;7,340&lt;/span&gt;
      &lt;span class="opensource__dot"&gt;&lt;/span&gt;
    &lt;/div&gt;
    &lt;h3 class="opensource__card-title"&gt;GitHub stars&lt;/h3&gt;
    &lt;p class="opensource__card-text"&gt;And growing every day.&lt;/p&gt;
  &lt;/div&gt;
  &lt;div class="opensource__links"&gt;
    &lt;a class="opensource__link" href="#"&gt;
      &lt;i class="bx bx-git-branch"&gt;&lt;/i&gt; View on GitHub
    &lt;/a&gt;
  &lt;/div&gt;
  &lt;div class="opensource__providers"&gt;
    &lt;div class="opensource__providers-track"&gt;
      &lt;img class="opensource__provider-logo" src="..." alt="" /&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.opensource__grid</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root CSS grid container for the section</td></tr>
      <tr><td>.opensource__corner</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Decorative corner or midpoint line element</td></tr>
      <tr><td>.opensource__corner--tl</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Top-left corner position</td></tr>
      <tr><td>.opensource__corner--tc1</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Top-center first junction</td></tr>
      <tr><td>.opensource__corner--tc2</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Top-center second junction</td></tr>
      <tr><td>.opensource__corner--tr</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Top-right corner position</td></tr>
      <tr><td>.opensource__corner--bl</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Bottom-left corner position</td></tr>
      <tr><td>.opensource__corner--bc1</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Bottom-center first junction</td></tr>
      <tr><td>.opensource__corner--bc2</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Bottom-center second junction</td></tr>
      <tr><td>.opensource__corner--br</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Bottom-right corner position</td></tr>
      <tr><td>.opensource__corner--ml</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Middle-left junction</td></tr>
      <tr><td>.opensource__corner--mc1</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Middle-center first junction</td></tr>
      <tr><td>.opensource__corner--mc2</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Middle-center second junction</td></tr>
      <tr><td>.opensource__corner--mr</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Middle-right junction</td></tr>
      <tr><td>.opensource__card</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual stat card</td></tr>
      <tr><td>.opensource__card:nth-child(3n+1)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Applies border-left to first column cards</td></tr>
      <tr><td>.opensource__card:nth-child(n+4)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Applies border-top to second row cards</td></tr>
      <tr><td>.opensource__stat</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Metric display row: icon, number, dot</td></tr>
      <tr><td>.opensource__stat svg</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Decorative SVG inside the stat row</td></tr>
      <tr><td>.opensource__metric</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Large numeric value</td></tr>
      <tr><td>.opensource__dot</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Live indicator dot</td></tr>
      <tr><td>.opensource__card-title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Card heading below the metric</td></tr>
      <tr><td>.opensource__card-text</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Supporting description text</td></tr>
      <tr><td>.opensource__links</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Link group area</td></tr>
      <tr><td>.opensource__link</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual link with icon</td></tr>
      <tr><td>.opensource__link:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover style for links</td></tr>
      <tr><td>.opensource__link i</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Boxicon inside the link</td></tr>
      <tr><td>.opensource__icon</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Standalone icon element</td></tr>
      <tr><td>.opensource__star</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Star icon element for the GitHub stars stat</td></tr>
      <tr><td>.opensource__providers</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Scrolling provider logo strip wrapper</td></tr>
      <tr><td>.opensource__providers-track</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Animated track inside the strip</td></tr>
      <tr><td>.opensource__provider-logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual provider logo image</td></tr>
    </tbody>
  </table>
</DocsLayout>
