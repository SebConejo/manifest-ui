---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Logo Menu">
  <h1>Logo Menu <span class="docs-tag">Navigation</span></h1>
  <p class="docs-lead">Dropdown logo picker menu. Toggles open/closed state.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="logo-menu is-open">
      <button class="logo-menu__item">
        <i class="bx bx-circle"></i> Default
      </button>
      <div class="logo-menu__separator"></div>
      <button class="logo-menu__item">
        <i class="bx bx-image"></i> Custom logo
      </button>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;div class="logo-menu is-open"&gt;
  &lt;button class="logo-menu__item"&gt;
    &lt;i class="bx bx-circle"&gt;&lt;/i&gt; Default
  &lt;/button&gt;
  &lt;div class="logo-menu__separator"&gt;&lt;/div&gt;
  &lt;button class="logo-menu__item"&gt;
    &lt;i class="bx bx-image"&gt;&lt;/i&gt; Custom logo
  &lt;/button&gt;
&lt;/div&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.logo-menu</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Dropdown menu container</td></tr>
      <tr><td>.logo-menu.is-open</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Expanded/visible state of the menu</td></tr>
      <tr><td>.logo-menu__item</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual menu button item</td></tr>
      <tr><td>.logo-menu__item:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover state of a menu item</td></tr>
      <tr><td>.logo-menu__item i</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Icon inside a menu item</td></tr>
      <tr><td>.logo-menu__separator</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Visual divider between menu groups</td></tr>
    </tbody>
  </table>
</DocsLayout>
