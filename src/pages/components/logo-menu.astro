---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Logo Menu">
  <h1>Logo Menu <span class="docs-tag">Navigation</span></h1>
  <p class="docs-lead">Dropdown logo picker menu. Toggles open/closed state.</p>

  <h2>Preview</h2>
  <div class="docs-preview">

    <div class="logo-menu is-open" style="position:relative;opacity:1;visibility:visible;transform:none;">
      <button class="logo-menu__item" data-action="copy-svg">
        <i class="bx bx-code-alt"></i>
        Copy Logo as SVG
      </button>
      <button class="logo-menu__item" data-action="download-png">
        <i class="bx bx-image"></i>
        Download Logo PNG
      </button>
      <button class="logo-menu__item" data-action="download-svg">
        <i class="bx bx-download"></i>
        Download Logo SVG
      </button>
      <div class="logo-menu__separator"></div>
      <a class="logo-menu__item" href="/brand-assets/">
        <i class="bx bx-package"></i>
        Brand Assets
      </a>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;div class="logo-menu is-open"&gt;
  &lt;button class="logo-menu__item" data-action="copy-svg"&gt;
    &lt;i class="bx bx-code-alt"&gt;&lt;/i&gt;
    Copy Logo as SVG
  &lt;/button&gt;
  &lt;button class="logo-menu__item" data-action="download-png"&gt;
    &lt;i class="bx bx-image"&gt;&lt;/i&gt;
    Download Logo PNG
  &lt;/button&gt;
  &lt;button class="logo-menu__item" data-action="download-svg"&gt;
    &lt;i class="bx bx-download"&gt;&lt;/i&gt;
    Download Logo SVG
  &lt;/button&gt;
  &lt;div class="logo-menu__separator"&gt;&lt;/div&gt;
  &lt;a class="logo-menu__item" href="/brand-assets/"&gt;
    &lt;i class="bx bx-package"&gt;&lt;/i&gt;
    Brand Assets
  &lt;/a&gt;
&lt;/div&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.logo-menu</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Dropdown menu container</td></tr>
      <tr><td>.logo-menu.is-open</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Expanded/visible state of the menu</td></tr>
      <tr><td>.logo-menu__item</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual menu button item</td></tr>
      <tr><td>.logo-menu__item:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover state of a menu item</td></tr>
      <tr><td>.logo-menu__item i</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Icon inside a menu item</td></tr>
      <tr><td>.logo-menu__separator</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Visual divider between menu groups</td></tr>
    </tbody>
  </table>
</DocsLayout>
