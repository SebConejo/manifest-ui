---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Nav">
  <h1>Nav <span class="docs-tag">Navigation</span></h1>
  <p class="docs-lead">Sticky navigation bar at the top of every page. Height 68px with backdrop blur.</p>

  <div class="docs-preview-note">
    Ce composant est un élément structurel pleine-page. Il ne peut pas être prévisualisé hors du contexte du site complet. Consulte le site live : <a href="https://manifest.build" target="_blank">manifest.build</a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;nav class="nav"&gt;
  &lt;div class="nav__inner"&gt;
    &lt;div class="nav__logo-wrap"&gt;
      &lt;a class="nav__logo" href="/"&gt;
        &lt;img class="nav__logo-img" src="/img/logo.svg" alt="Manifest" /&gt;
        &lt;img class="nav__logo-img nav__logo-img--mobile" src="/img/logo-mark.svg" alt="" /&gt;
      &lt;/a&gt;
    &lt;/div&gt;
    &lt;ul class="nav__links"&gt;
      &lt;li class="nav__item"&gt;&lt;a class="nav__link" href="#"&gt;Docs&lt;/a&gt;&lt;/li&gt;
      &lt;li class="nav__item nav__trigger"&gt;
        Solutions &lt;span class="nav__chevron"&gt;&amp;#8964;&lt;/span&gt;
      &lt;/li&gt;
    &lt;/ul&gt;
    &lt;div class="nav__actions"&gt;
      &lt;a class="nav__signin" href="#"&gt;Sign in&lt;/a&gt;
      &lt;a class="nav__badge" href="#"&gt;
        &lt;span class="nav__social-label"&gt;Stars&lt;/span&gt;
        &lt;span class="nav__social-count nav__social--stars"&gt;1.2k&lt;/span&gt;
      &lt;/a&gt;
      &lt;a class="btn btn--primary" href="#"&gt;Get started&lt;/a&gt;
    &lt;/div&gt;
    &lt;button class="nav__burger" aria-label="Open menu"&gt;&amp;#9776;&lt;/button&gt;
  &lt;/div&gt;
&lt;/nav&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.nav .nav__links</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Links row, stretched to full header height so the mega panel anchors flush to the bottom border</td></tr>
      <tr><td>.nav__item</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex list item aligned to full nav height</td></tr>
      <tr><td>.nav__trigger</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Button that opens a mega menu; borderless, inherits body font at var(--size-sm) weight 600</td></tr>
      <tr><td>.nav__trigger:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Color shifts to var(--color-accent)</td></tr>
      <tr><td>.nav__trigger[aria-expanded='true']</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Color shifts to var(--color-accent) while the panel is open</td></tr>
      <tr><td>.nav__chevron</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Chevron icon inside a trigger; rotates 180° when the panel is open</td></tr>
      <tr><td>.nav__trigger[aria-expanded='true'] .nav__chevron</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Applies rotate(180deg) to the chevron</td></tr>
      <tr><td>.nav__burger</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">44×44 px hamburger button, hidden on desktop, shown below 1023 px</td></tr>
      <tr><td>.nav__scrim</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Fixed full-screen overlay with blur backdrop shown behind open menus</td></tr>
      <tr><td>.nav__social--stars</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Two-part pill button (label + count) for the GitHub star count; 28 px tall, 6 px radius border</td></tr>
      <tr><td>.nav__social--stars:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Darkens the outer border and the inner divider</td></tr>
      <tr><td>.nav__social-label</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Left half of the stars button; card background with icon and label text</td></tr>
      <tr><td>.nav__social-count</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Right half of the stars button; alt background, tabular-nums, left-border divider</td></tr>
      <tr><td>.drawer__socials</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row of social links at the bottom of the mobile drawer; defined in nav-menu.css</td></tr>
    </tbody>
  </table>
</DocsLayout>
