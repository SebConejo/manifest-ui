---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Nav">
  <h1>Nav <span class="docs-tag">Navigation</span></h1>
  <p class="docs-lead">Sticky navigation bar at the top of every page. Height 68px with backdrop blur.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    <link rel="stylesheet" href="/styles/manifest.css" />
    <nav class="nav">
      <div class="nav__inner">
        <div class="nav__logo-wrap">
          <a class="nav__logo" href="/">
            <img class="nav__logo-img" src="/img/logo.svg" alt="Manifest" />
          </a>
        </div>
        <ul class="nav__links">
          <li class="nav__item"><a class="nav__link" href="#">Docs</a></li>
          <li class="nav__item"><a class="nav__link" href="#">Pricing</a></li>
          <li class="nav__item nav__trigger">
            Solutions <span class="nav__chevron">&#8964;</span>
          </li>
        </ul>
        <div class="nav__actions">
          <a class="nav__signin" href="#">Sign in</a>
          <a class="btn btn--primary" href="#">Get started</a>
        </div>
        <button class="nav__burger" aria-label="Open menu">&#9776;</button>
      </div>
    </nav>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;nav class="nav"&gt;
  &lt;div class="nav__inner"&gt;
    &lt;div class="nav__logo-wrap"&gt;
      &lt;a class="nav__logo" href="/"&gt;
        &lt;img class="nav__logo-img" src="/img/logo.svg" alt="Manifest" /&gt;
        &lt;img class="nav__logo-img nav__logo-img--mobile" src="/img/logo-mark.svg" alt="" /&gt;
      &lt;/a&gt;
    &lt;/div&gt;
    &lt;ul class="nav__links"&gt;
      &lt;li class="nav__item"&gt;&lt;a class="nav__link" href="#"&gt;Docs&lt;/a&gt;&lt;/li&gt;
      &lt;li class="nav__item nav__trigger"&gt;
        Solutions &lt;span class="nav__chevron"&gt;&amp;#8964;&lt;/span&gt;
      &lt;/li&gt;
    &lt;/ul&gt;
    &lt;div class="nav__actions"&gt;
      &lt;a class="nav__signin" href="#"&gt;Sign in&lt;/a&gt;
      &lt;a class="nav__badge" href="#"&gt;
        &lt;span class="nav__social-label"&gt;Stars&lt;/span&gt;
        &lt;span class="nav__social-count nav__social--stars"&gt;1.2k&lt;/span&gt;
      &lt;/a&gt;
      &lt;a class="btn btn--primary" href="#"&gt;Get started&lt;/a&gt;
    &lt;/div&gt;
    &lt;button class="nav__burger" aria-label="Open menu"&gt;&amp;#9776;&lt;/button&gt;
  &lt;/div&gt;
&lt;/nav&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.nav</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root sticky navigation bar, height 68px with backdrop blur</td></tr>
      <tr><td>.nav__inner</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Inner flex row constraining all nav children</td></tr>
      <tr><td>.nav__logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Logo anchor wrapping the logo image</td></tr>
      <tr><td>.nav__logo-img</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Logo image, full wordmark by default</td></tr>
      <tr><td>.nav__logo-img--mobile</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Alternate logo mark shown on small screens</td></tr>
      <tr><td>.nav__logo-wrap</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Wrapper that controls logo layout and spacing</td></tr>
      <tr><td>.nav__links</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Horizontal list of navigation items</td></tr>
      <tr><td>.nav__link</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual navigation anchor</td></tr>
      <tr><td>.nav__actions</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Right-side slot for CTA and auth links</td></tr>
      <tr><td>.nav__signin</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Sign in text link</td></tr>
      <tr><td>.nav__badge</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Pill badge used for social proof (stars, etc.)</td></tr>
      <tr><td>.nav__item</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">List item in .nav__links</td></tr>
      <tr><td>.nav__trigger</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Nav item that opens a mega menu on click</td></tr>
      <tr><td>.nav__chevron</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Chevron icon inside a trigger item</td></tr>
      <tr><td>.nav__burger</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Hamburger button that opens the mobile drawer</td></tr>
      <tr><td>.nav__scrim</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Full-screen overlay shown behind open menus</td></tr>
      <tr><td>.nav__social--stars</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Stars icon variant for .nav__badge social count</td></tr>
      <tr><td>.nav__social-label</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Label text inside the social badge</td></tr>
      <tr><td>.nav__social-count</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Numeric count inside the social badge</td></tr>
    </tbody>
  </table>
</DocsLayout>
