---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Blog Grid">
  <h1>Blog Grid <span class="docs-tag">Blog</span></h1>
  <p class="docs-lead">CSS grid container for blog cards. Responsive: 3 columns desktop, 2 tablet, 1 mobile.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="blog-grid">
      <a class="blog-card" href="#">
        <div class="blog-card__img-wrap">
          <img class="blog-card__img" src="https://placehold.co/600x314/fcfaf5/2c2418?text=Cover" alt="Cover" />
        </div>
        <div class="blog-card__body">
          <span class="blog-card__date">Aug 3, 2026</span>
          <h3 class="blog-card__title">First article title</h3>
          <p class="blog-card__desc">Short description of the article.</p>
        </div>
      </a>
      <a class="blog-card" href="#">
        <div class="blog-card__img-wrap">
          <img class="blog-card__img" src="https://placehold.co/600x314/fcfaf5/2c2418?text=Cover" alt="Cover" />
        </div>
        <div class="blog-card__body">
          <span class="blog-card__date">Aug 3, 2026</span>
          <h3 class="blog-card__title">Second article title</h3>
          <p class="blog-card__desc">Short description of the article.</p>
        </div>
      </a>
      <a class="blog-card" href="#">
        <div class="blog-card__img-wrap">
          <img class="blog-card__img" src="https://placehold.co/600x314/fcfaf5/2c2418?text=Cover" alt="Cover" />
        </div>
        <div class="blog-card__body">
          <span class="blog-card__date">Aug 3, 2026</span>
          <h3 class="blog-card__title">Third article title</h3>
          <p class="blog-card__desc">Short description of the article.</p>
        </div>
      </a>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="blog-grid"&gt;
  &lt;a class="blog-card" href="#"&gt;...&lt;/a&gt;
  &lt;a class="blog-card" href="#"&gt;...&lt;/a&gt;
  &lt;a class="blog-card" href="#"&gt;...&lt;/a&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.blog-grid</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Layout-only grid container, no child BEM elements</td></tr>
    </tbody>
  </table>
</DocsLayout>
