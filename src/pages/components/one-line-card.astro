---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="One Line Card">
  <h1>One Line Card <span class="docs-tag">Cards</span></h1>
  <p class="docs-lead">Single-row card showing a logo and a label side by side. Used for related providers or agents inline.</p>

  <h2>Preview</h2>
  <div class="docs-preview" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
    <a class="related-card" href="#" style="text-decoration:none;">
      <div style="width:32px;height:32px;border-radius:4px;background:#dbd7d0;flex-shrink:0;"></div>
      <span class="related-card__name">OpenAI</span>
    </a>
    <a class="related-card" href="#" style="text-decoration:none;">
      <div style="width:32px;height:32px;border-radius:4px;background:#dbd7d0;flex-shrink:0;"></div>
      <span class="related-card__name">Anthropic</span>
    </a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;a class="related-card" href="/providers/openai/"&gt;
  &lt;img class="related-card__logo" src="openai.svg" alt="OpenAI" /&gt;
  &lt;span class="related-card__name"&gt;OpenAI&lt;/span&gt;
&lt;/a&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.related-card</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Flex row card; inline-flex, gap var(--space-xs), align-items center, border, border-radius 3px, padding var(--space-xs) var(--space-sm)</td></tr>
      <tr><td>.related-card:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Elevated shadow on hover</td></tr>
      <tr><td>.related-card__logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">32×32 logo image; object-fit contain</td></tr>
      <tr><td>.related-card__name</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Label text; var(--size-sm), weight 500</td></tr>
    </tbody>
  </table>
</DocsLayout>
