---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Model Listing">
  <h1>Model Listing <span class="docs-tag">Tables</span></h1>
  <p class="docs-lead">Tabbed model listing with hideable panels. Used on provider detail pages.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="model-listing">
      <div class="model-listing__tabs">
        <button class="model-listing__tab model-listing__tab--active">All models</button>
        <button class="model-listing__tab">Chat</button>
        <button class="model-listing__tab">Embedding</button>
      </div>
      <div class="model-listing__wrapper">
        <!-- model-table here -->
      </div>
      <div class="model-listing__wrapper model-listing__panel--hidden">
        <!-- hidden panel -->
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="model-listing"&gt;
  &lt;div class="model-listing__tabs"&gt;
    &lt;button class="model-listing__tab model-listing__tab--active"&gt;All models&lt;/button&gt;
    &lt;button class="model-listing__tab"&gt;Chat&lt;/button&gt;
    &lt;button class="model-listing__tab"&gt;Embedding&lt;/button&gt;
  &lt;/div&gt;
  &lt;div class="model-listing__wrapper"&gt;
    &lt;!-- model-table here --&gt;
  &lt;/div&gt;
  &lt;div class="model-listing__wrapper model-listing__panel--hidden"&gt;
    &lt;!-- hidden panel --&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.model-listing</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root wrapper for the tabbed listing</td></tr>
      <tr><td>.model-listing__wrapper</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Container for a single tab panel</td></tr>
      <tr><td>.model-listing__tabs</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Tab bar row</td></tr>
      <tr><td>.model-listing__tab</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Individual tab button</td></tr>
      <tr><td>.model-listing__tab--active</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Selected tab state</td></tr>
      <tr><td>.model-listing__tab:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover style on inactive tab</td></tr>
      <tr><td>.model-listing__tab--active:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover style on the active tab</td></tr>
      <tr><td>.model-listing__panel--hidden</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Hides a panel when its tab is not selected</td></tr>
    </tbody>
  </table>
</DocsLayout>
