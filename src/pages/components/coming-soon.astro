---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Coming Soon">
  <h1>Coming Soon <span class="docs-tag">Page</span></h1>
  <p class="docs-lead">Stub page template used while a feature section is in development. Includes a badge, title, lede, feature points list, CTAs, and a footnote.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="coming-soon">
      <span class="coming-soon__badge">
        <i class="bx bx-time-five"></i> Coming soon
      </span>
      <h1 class="coming-soon__title">LLM Gateway</h1>
      <p class="coming-soon__lede">One endpoint for every model. Route, cache, and observe all your LLM traffic from a single place.</p>
      <ul class="coming-soon__points">
        <li><i class="bx bx-check-circle"></i> Unified API across 30+ providers</li>
        <li><i class="bx bx-check-circle"></i> Automatic retries and fallback</li>
        <li><i class="bx bx-check-circle"></i> Per-key spend limits</li>
      </ul>
      <div class="coming-soon__actions">
        <a href="#" class="btn">Join the waitlist</a>
        <a href="#" class="btn btn--ghost">Learn more</a>
      </div>
      <p class="coming-soon__note">Already using Manifest? <a href="#">Contact us</a> for early access.</p>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="coming-soon"&gt;
  &lt;span class="coming-soon__badge"&gt;
    &lt;i class="bx bx-time-five"&gt;&lt;/i&gt; Coming soon
  &lt;/span&gt;
  &lt;h1 class="coming-soon__title"&gt;LLM Gateway&lt;/h1&gt;
  &lt;p class="coming-soon__lede"&gt;One endpoint for every model.&lt;/p&gt;
  &lt;ul class="coming-soon__points"&gt;
    &lt;li&gt;&lt;i class="bx bx-check-circle"&gt;&lt;/i&gt; Unified API across 30+ providers&lt;/li&gt;
    &lt;li&gt;&lt;i class="bx bx-check-circle"&gt;&lt;/i&gt; Automatic retries and fallback&lt;/li&gt;
  &lt;/ul&gt;
  &lt;div class="coming-soon__actions"&gt;
    &lt;a href="#" class="btn"&gt;Join the waitlist&lt;/a&gt;
    &lt;a href="#" class="btn btn--ghost"&gt;Learn more&lt;/a&gt;
  &lt;/div&gt;
  &lt;p class="coming-soon__note"&gt;Already using Manifest? &lt;a href="#"&gt;Contact us&lt;/a&gt;.&lt;/p&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.coming-soon</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root section with 2xl top and 3xl bottom padding</td></tr>
      <tr><td>.coming-soon__badge</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Pill badge with accent background and icon</td></tr>
      <tr><td>.coming-soon__badge i</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Icon inside the badge at 1 rem</td></tr>
      <tr><td>.coming-soon__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Page heading at 4xl size</td></tr>
      <tr><td>.coming-soon__lede</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted lead paragraph at xl size with 1.5 line height</td></tr>
      <tr><td>.coming-soon__points</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Unstyled grid list of feature points</td></tr>
      <tr><td>.coming-soon__points li</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row pairing icon and label text</td></tr>
      <tr><td>.coming-soon__points i</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Accent-colored icon, shrink-prevented</td></tr>
      <tr><td>.coming-soon__actions</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Wrapping flex row for CTA buttons</td></tr>
      <tr><td>.coming-soon__note</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Small muted footnote below the actions</td></tr>
      <tr><td>.coming-soon__note a</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Bold accent link inside the note</td></tr>
      <tr><td>.coming-soon__note a:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Underline on hover</td></tr>
      <tr><td>.coming-soon__title (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Reduces to 3xl below 768 px</td></tr>
      <tr><td>.coming-soon__lede (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Reduces to base size below 768 px</td></tr>
    </tbody>
  </table>
</DocsLayout>
