---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Free Models Hero">
  <h1>Free Models Hero <span class="docs-tag">Hero</span></h1>
  <p class="docs-lead">Top-of-page hero for the free models listing. Displays a breadcrumb, large title, and a muted subtitle capped at 560 px.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="free-models-hero">
      <p class="free-models-hero__breadcrumb">Free LLM APIs</p>
      <h1 class="free-models-hero__title">Run models for free</h1>
      <p class="free-models-hero__subtitle">Zero-cost access to production-grade models from the best providers. No credit card required.</p>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="free-models-hero"&gt;
  &lt;p class="free-models-hero__breadcrumb"&gt;Free LLM APIs&lt;/p&gt;
  &lt;h1 class="free-models-hero__title"&gt;Run models for free&lt;/h1&gt;
  &lt;p class="free-models-hero__subtitle"&gt;Zero-cost access to production-grade models from the best providers.&lt;/p&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.free-models-hero</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root section with 2xl top and lg bottom padding</td></tr>
      <tr><td>.free-models-hero__breadcrumb</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Uppercase sm label above the title, muted color</td></tr>
      <tr><td>.free-models-hero__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Large 4xl page heading</td></tr>
      <tr><td>.free-models-hero__subtitle</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted lg subtitle capped at 560 px with 1.6 line height</td></tr>
      <tr><td>.free-models-hero__title (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Reduces font size below 768 px</td></tr>
    </tbody>
  </table>
</DocsLayout>
