---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Free Models Providers">
  <h1>Free Models Providers <span class="docs-tag">Layout</span></h1>
  <p class="docs-lead">Section wrapper for the free-models page provider listing. Adds bottom padding before subsequent sections.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    <link rel="stylesheet" href="/styles/manifest.css" />
    <div class="free-models-providers">
      <p style="color:var(--color-text-muted);font-size:var(--size-sm)">Provider cards render here.</p>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="free-models-providers"&gt;
  &lt;!-- provider cards --&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.free-models-providers</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root wrapper; applies bottom padding of <code>--space-2xl</code></td></tr>
    </tbody>
  </table>
</DocsLayout>
