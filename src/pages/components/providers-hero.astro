---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Providers Hero">
  <h1>Providers Hero <span class="docs-tag">Hero</span></h1>
  <p class="docs-lead">Page header for the providers index. Large display title with a muted subtitle underneath.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    <link rel="stylesheet" href="/styles/manifest.css" />
    <div class="providers-hero">
      <h1 class="providers-hero__title">All providers</h1>
      <p class="providers-hero__subtitle">Browse every LLM provider available through Manifest.</p>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="providers-hero"&gt;
  &lt;h1 class="providers-hero__title"&gt;All providers&lt;/h1&gt;
  &lt;p class="providers-hero__subtitle"&gt;Browse every LLM provider available through Manifest.&lt;/p&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.providers-hero</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root element; sets top and bottom padding</td></tr>
      <tr><td>.providers-hero__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Display-weight page title in the display font</td></tr>
      <tr><td>.providers-hero__title (max-width: 768px)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Reduces title to --size-3xl on small screens</td></tr>
      <tr><td>.providers-hero__subtitle</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted body-font subtitle below the title</td></tr>
    </tbody>
  </table>
</DocsLayout>
