---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Blog Card">
  <h1>Blog Card <span class="docs-tag">Blog</span></h1>
  <p class="docs-lead">Article preview card used in the blog grid and homepage feed. Fixed 1.91:1 image ratio, 2-line title clamp, 3-line description clamp.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <a class="blog-card" href="#">
      <div class="blog-card__img-wrap">
        <img class="blog-card__img" src="https://placehold.co/600x314/fcfaf5/2c2418?text=Cover" alt="Cover" />
      </div>
      <div class="blog-card__body">
        <span class="blog-card__date">Aug 3, 2026</span>
        <h3 class="blog-card__title">Article title goes here on two lines max</h3>
        <p class="blog-card__desc">Short description of the article, clamped to three lines maximum in the UI.</p>
      </div>
    </a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;a class="blog-card" href="#"&gt;
  &lt;div class="blog-card__img-wrap"&gt;
    &lt;img class="blog-card__img" src="https://placehold.co/600x314/fcfaf5/2c2418?text=Cover" alt="Cover" /&gt;
  &lt;/div&gt;
  &lt;div class="blog-card__body"&gt;
    &lt;span class="blog-card__date"&gt;Aug 3, 2026&lt;/span&gt;
    &lt;h3 class="blog-card__title"&gt;Article title goes here on two lines max&lt;/h3&gt;
    &lt;p class="blog-card__desc"&gt;Short description of the article, clamped to three lines maximum in the UI.&lt;/p&gt;
  &lt;/div&gt;
&lt;/a&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.blog-card</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Card root anchor element</td></tr>
      <tr><td>.blog-card__img-wrap</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Aspect-ratio 1.91:1 image container</td></tr>
      <tr><td>.blog-card__img</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Cover image, fills the wrap</td></tr>
      <tr><td>.blog-card__body</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Text content area below the image</td></tr>
      <tr><td>.blog-card__date</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Publication date label</td></tr>
      <tr><td>.blog-card__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Article title, clamped to 2 lines</td></tr>
      <tr><td>.blog-card__desc</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Article description, clamped to 3 lines</td></tr>
    </tbody>
  </table>

  <h2>Tokens used</h2>
  <table class="docs-table">
    <thead><tr><th>Token</th><th>Role</th></tr></thead>
    <tbody>
      <tr><td>--color-bg-card</td><td style="color:var(--docs-text-muted)">Card background</td></tr>
      <tr><td>--radius</td><td style="color:var(--docs-text-muted)">Card border radius</td></tr>
      <tr><td>--space-md</td><td style="color:var(--docs-text-muted)">Body padding</td></tr>
    </tbody>
  </table>
</DocsLayout>
