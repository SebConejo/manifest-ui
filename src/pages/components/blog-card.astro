---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Blog Card">
  <h1>Blog Card <span class="docs-tag">Blog</span></h1>
  <p class="docs-lead">Article preview card used in the blog grid. Fixed 1.91:1 image ratio, 2-line title clamp, 3-line description clamp.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    <a class="blog-card" href="#" style="max-width:300px;display:flex;flex-direction:column;text-decoration:none;color:inherit">
      <div class="blog-card__img-wrap"></div>
      <div class="blog-card__body">
        <time class="blog-card__date" datetime="2026-08-03">Aug 3, 2026</time>
        <h2 class="blog-card__title">Article title goes here on two lines max</h2>
        <p class="blog-card__desc">Short description of the article, clamped to three lines maximum in the UI.</p>
      </div>
    </a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;a class="blog-card" href="/blog/slug/"&gt;
  &lt;div class="blog-card__img-wrap"&gt;
    &lt;img class="blog-card__img" src="cover.png" alt="Alt text" loading="lazy" width="1200" height="628" /&gt;
  &lt;/div&gt;
  &lt;div class="blog-card__body"&gt;
    &lt;time class="blog-card__date" datetime="2026-08-03"&gt;Aug 3, 2026&lt;/time&gt;
    &lt;h2 class="blog-card__title"&gt;Article title&lt;/h2&gt;
    &lt;p class="blog-card__desc"&gt;Short description.&lt;/p&gt;
  &lt;/div&gt;
&lt;/a&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.blog-card</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Flex column card; 1px border rgba(44,36,24,.06), border-radius 3px, overflow hidden</td></tr>
      <tr><td>.blog-card:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">translateY(-2px) and box-shadow 0 8px 24px rgba(44,36,24,.08)</td></tr>
      <tr><td>.blog-card__img-wrap</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">aspect-ratio 1.91/1; background var(--color-bg-alt); overflow hidden</td></tr>
      <tr><td>.blog-card__img</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">100% width and height; object-fit cover</td></tr>
      <tr><td>.blog-card__img[src$=".svg"]</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">SVG images switch to object-fit contain</td></tr>
      <tr><td>.blog-card__body</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex column; padding var(--space-md); gap var(--space-xs)</td></tr>
      <tr><td>.blog-card__date</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">var(--size-sm); muted color; weight 500</td></tr>
      <tr><td>.blog-card__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">var(--font-display); var(--size-xl); weight 600; line-height 1.3; -webkit-line-clamp 2</td></tr>
      <tr><td>.blog-card__desc</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">var(--size-sm); muted color; line-height 1.6; -webkit-line-clamp 3</td></tr>
    </tbody>
  </table>
</DocsLayout>
