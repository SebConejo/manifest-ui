---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Changelog">
  <h1>Changelog <span class="docs-tag">Content</span></h1>
  <p class="docs-lead">Auto-generated release history rendered from GitHub releases. Entries are grouped by month, each with a sticky aside showing date, version badge, and release tag.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <div class="changelog">
      <div class="changelog__intro">
        <h1 class="changelog__title">Changelog</h1>
        <p class="changelog__lede">Every release, from the latest feature to the smallest fix. Full history on <a href="#">GitHub</a>.</p>
      </div>
      <div class="changelog__month">
        <p class="changelog__month-label">August 2026</p>
        <ul class="changelog__entries">
          <li class="changelog__entry">
            <div class="changelog__aside">
              <span class="changelog__date">Aug 3</span>
              <a href="#" class="changelog__version">
                <span class="changelog__version-badge">v2.4.0</span>
              </a>
              <span class="changelog__tag">stable</span>
            </div>
            <div class="changelog__notes">
              <h3>New provider icons</h3>
              <p>Added icons for all major LLM providers in the dashboard sidebar.</p>
            </div>
          </li>
          <li class="changelog__entry">
            <div class="changelog__aside">
              <span class="changelog__date">Aug 1</span>
              <a href="#" class="changelog__version">
                <span class="changelog__version-badge">v2.3.1</span>
              </a>
              <span class="changelog__tag changelog__tag--pre">pre</span>
            </div>
            <div class="changelog__notes">
              <p class="changelog__empty-note">No release notes.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="changelog__archive">
        <a href="#" class="btn btn--ghost">View full archive</a>
      </div>
    </div>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;div class="changelog"&gt;
  &lt;div class="changelog__intro"&gt;
    &lt;h1 class="changelog__title"&gt;Changelog&lt;/h1&gt;
    &lt;p class="changelog__lede"&gt;Every release&hellip; &lt;a href="#"&gt;GitHub&lt;/a&gt;.&lt;/p&gt;
  &lt;/div&gt;

  &lt;div class="changelog__month"&gt;
    &lt;p class="changelog__month-label"&gt;August 2026&lt;/p&gt;
    &lt;ul class="changelog__entries"&gt;
      &lt;li class="changelog__entry"&gt;
        &lt;div class="changelog__aside"&gt;
          &lt;span class="changelog__date"&gt;Aug 3&lt;/span&gt;
          &lt;a href="#" class="changelog__version"&gt;
            &lt;span class="changelog__version-badge"&gt;v2.4.0&lt;/span&gt;
          &lt;/a&gt;
          &lt;span class="changelog__tag"&gt;stable&lt;/span&gt;
          &lt;a href="#" class="changelog__source"&gt;Release notes&lt;/a&gt;
        &lt;/div&gt;
        &lt;div class="changelog__notes"&gt;
          &lt;h3&gt;New feature&lt;/h3&gt;
          &lt;p&gt;Description of the change.&lt;/p&gt;
        &lt;/div&gt;
      &lt;/li&gt;
    &lt;/ul&gt;
  &lt;/div&gt;

  &lt;div class="changelog__archive"&gt;
    &lt;a href="#" class="btn btn--ghost"&gt;View full archive&lt;/a&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.changelog</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root section with top and bottom padding</td></tr>
      <tr><td>.changelog__intro</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Intro container capped at 640 px</td></tr>
      <tr><td>.changelog__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Display-font heading at 4xl size</td></tr>
      <tr><td>.changelog__lede</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted intro paragraph at lg size</td></tr>
      <tr><td>.changelog__lede a</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Accent-colored underline link inside the lede</td></tr>
      <tr><td>.changelog__month</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Monthly grouping wrapper</td></tr>
      <tr><td>.changelog__month-label</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Uppercase small-caps month heading</td></tr>
      <tr><td>.changelog__entries</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Unstyled list of entry items</td></tr>
      <tr><td>.changelog__entry</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Two-column grid: 150 px aside + 1fr notes, top-bordered</td></tr>
      <tr><td>.changelog__aside</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Sticky left rail with date, badge, and tag</td></tr>
      <tr><td>.changelog__date</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Muted date label at sm size</td></tr>
      <tr><td>.changelog__version</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Link wrapping the version badge</td></tr>
      <tr><td>.changelog__version-badge</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Monospace pill badge showing the semver string</td></tr>
      <tr><td>.changelog__version:hover .changelog__version-badge</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Adds accent border on hover</td></tr>
      <tr><td>.changelog__tag</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Uppercase release-type label (stable, pre)</td></tr>
      <tr><td>.changelog__tag--pre</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Amber color for pre-release tags</td></tr>
      <tr><td>.changelog__notes</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Rendered markdown content area for release notes</td></tr>
      <tr><td>.changelog__notes h2/h3/h4</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Headings inside notes, normalized to lg weight-600</td></tr>
      <tr><td>.changelog__notes p</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Body paragraph with 1.75 line height</td></tr>
      <tr><td>.changelog__notes ul/ol</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">List elements inside notes</td></tr>
      <tr><td>.changelog__notes a:not(.btn)</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Underlined accent link inside notes</td></tr>
      <tr><td>.changelog__notes a:not(.btn):hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Darker accent on hover</td></tr>
      <tr><td>.changelog__notes strong</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Bold text inside notes</td></tr>
      <tr><td>.changelog__notes blockquote</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Left-bordered italic quote block</td></tr>
      <tr><td>.changelog__notes code</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Monospace inline code with alt background</td></tr>
      <tr><td>.changelog__notes pre</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Dark code block with scrollable overflow</td></tr>
      <tr><td>.changelog__notes pre code</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Code inside pre, background stripped</td></tr>
      <tr><td>.changelog__empty-note</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Italic muted placeholder when no notes exist</td></tr>
      <tr><td>.changelog__source</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Small muted link to the GitHub release</td></tr>
      <tr><td>.changelog__source:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Accent color on hover</td></tr>
      <tr><td>.changelog__archive</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Centered archive link area at the bottom</td></tr>
      <tr><td>.changelog__empty</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Full-width empty state message</td></tr>
      <tr><td>.changelog__empty a</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Underlined accent link inside the empty state</td></tr>
      <tr><td>.changelog__entry (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Single-column layout below 768 px</td></tr>
      <tr><td>.changelog__aside (mobile)</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Horizontal row on mobile, no longer sticky</td></tr>
    </tbody>
  </table>
</DocsLayout>
