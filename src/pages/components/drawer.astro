---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Drawer">
  <h1>Drawer <span class="docs-tag">Navigation</span></h1>
  <p class="docs-lead">Mobile navigation drawer. Opens from the right on screens &lt; 1024px.</p>

  <div class="docs-preview-note">
    Ce composant est un élément structurel pleine-page. Il ne peut pas être prévisualisé hors du contexte du site complet. Consulte le site live : <a href="https://manifest.build" target="_blank">manifest.build</a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;!-- Trigger --&gt;
&lt;button class="nav__burger" aria-label="Open menu"&gt;&amp;#9776;&lt;/button&gt;

&lt;!-- Drawer panel --&gt;
&lt;div class="drawer is-open"&gt;
  &lt;div class="drawer__inner"&gt;
    &lt;div class="drawer__summary"&gt;
      &lt;a class="drawer__top-link" href="#"&gt;Home&lt;/a&gt;
    &lt;/div&gt;
    &lt;div class="drawer__panel"&gt;
      &lt;a class="drawer__link" href="#"&gt;Docs&lt;/a&gt;
      &lt;a class="drawer__link" href="#"&gt;Pricing&lt;/a&gt;
    &lt;/div&gt;
    &lt;div class="drawer__actions"&gt;
      &lt;a class="btn btn--primary" href="#"&gt;Get started&lt;/a&gt;
    &lt;/div&gt;
    &lt;div class="drawer__socials"&gt;
      &lt;a href="#"&gt;GitHub&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.drawer</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Full-width panel below the nav bar, hidden by default; slides down on open</td></tr>
      <tr><td>.drawer.is-open</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Sets opacity 1, visibility visible, translateY(0)</td></tr>
      <tr><td>body.has-drawer-open</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Locks body scroll while the drawer is open</td></tr>
      <tr><td>.drawer__inner</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex column inside the drawer; padding 12px 5% 24px</td></tr>
      <tr><td>.drawer__summary</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Accordion summary row; flex space-between, bottom border, font weight 600 at var(--size-base)</td></tr>
      <tr><td>.drawer__summary::-webkit-details-marker</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hides the native details/summary triangle in WebKit</td></tr>
      <tr><td>.drawer__summary i</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Chevron icon inside the summary; muted color, rotates 180° when section is open</td></tr>
      <tr><td>.drawer__section[open] .drawer__summary i</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Applies rotate(180deg) to the summary chevron</td></tr>
      <tr><td>.drawer__top-link</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Shares the same rule as .drawer__summary; top-level anchor link with matching flex and border style</td></tr>
      <tr><td>.drawer__panel</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex column of links; padding 6px 0 12px</td></tr>
      <tr><td>.drawer__link</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row link; gap 12px, muted color at var(--size-sm) weight 500, 10 px border radius</td></tr>
      <tr><td>.drawer__link i:first-child</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Leading icon at 1.2 rem</td></tr>
      <tr><td>.drawer__link:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Alt background, text shifts to var(--color-text)</td></tr>
      <tr><td>.drawer__actions</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Flex row of CTA buttons; gap 12px, margin-top 20px</td></tr>
      <tr><td>.drawer__actions .btn</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Each button grows to fill equal width (flex: 1) and centers its label</td></tr>
      <tr><td>.nav__burger</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Hamburger button that triggers the drawer; hidden on desktop, displayed below 1023 px</td></tr>
      <tr><td>.nav__scrim</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Fixed full-screen overlay with blur backdrop</td></tr>
    </tbody>
  </table>
</DocsLayout>
