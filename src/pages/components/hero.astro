---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Hero">
  <h1>Hero <span class="docs-tag">Global</span></h1>
  <p class="docs-lead">Main hero section. Rich component with many child elements covering stats, terminal, screenshots, backed-by logos, and decorative shadows.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <section class="hero">
      <div class="hero__top container">
        <div class="hero__copy">
          <p class="hero__eyebrow">Tag line</p>
          <h1 class="hero__title">Title <span class="hero__title-accent">accent</span></h1>
          <p class="hero__subtitle">Subtitle text</p>
          <div class="hero__actions">
            <button class="btn btn--primary">Get started</button>
            <button class="btn btn--secondary">Learn more</button>
          </div>
        </div>
        <div class="hero__diagram"><!-- visual --></div>
      </div>
    </section>
  </div>

  <h2>HTML</h2>
  <div class="docs-code"><pre>&lt;section class="hero"&gt;
  &lt;div class="hero__top container"&gt;
    &lt;div class="hero__copy"&gt;
      &lt;p class="hero__eyebrow"&gt;Tag line&lt;/p&gt;
      &lt;h1 class="hero__title"&gt;Title &lt;span class="hero__title-accent"&gt;accent&lt;/span&gt;&lt;/h1&gt;
      &lt;p class="hero__subtitle"&gt;Subtitle text&lt;/p&gt;
      &lt;div class="hero__actions"&gt;
        &lt;button class="btn btn--primary"&gt;Get started&lt;/button&gt;
        &lt;button class="btn btn--secondary"&gt;Learn more&lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="hero__diagram"&gt;&lt;!-- visual --&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/section&gt;</pre></div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.hero</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root hero section</td></tr>
      <tr><td>.hero__top</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Top row with copy and diagram</td></tr>
      <tr><td>.hero__copy</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Left-side text content block</td></tr>
      <tr><td>.hero__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Main heading</td></tr>
      <tr><td>.hero__title-accent</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Highlighted span inside the title</td></tr>
      <tr><td>.hero__subtitle</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Supporting paragraph below the title</td></tr>
      <tr><td>.hero__eyebrow</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Small label above the title</td></tr>
      <tr><td>.hero__actions</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">CTA button row</td></tr>
      <tr><td>.hero__diagram</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Right-side visual area</td></tr>
      <tr><td>.hero__below</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Section below the top row</td></tr>
      <tr><td>.hero__features</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Feature list wrapper</td></tr>
      <tr><td>.hero__logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Logo mark inside the hero</td></tr>
