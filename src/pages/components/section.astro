---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Section">
  <h1>Section <span class="docs-tag">Layout</span></h1>
  <p class="docs-lead">Section wrapper with background variants and structured children (tag, title, subtitle, body).</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <section class="section section--alt">
      <div class="container">
        <p class="section__tag">Tag label</p>
        <h2 class="section__title">Section title</h2>
        <p class="section__subtitle">Subtitle text supporting the section heading.</p>
        <div class="section__body">Content goes here.</div>
      </div>
    </section>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;section class="section section--alt"&gt;
  &lt;div class="container"&gt;
    &lt;p class="section__tag"&gt;Tag label&lt;/p&gt;
    &lt;h2 class="section__title"&gt;Section title&lt;/h2&gt;
    &lt;p class="section__subtitle"&gt;Subtitle text&lt;/p&gt;
    &lt;div class="section__body"&gt;Content&lt;/div&gt;
  &lt;/div&gt;
&lt;/section&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.section</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Root section wrapper with vertical padding and default background</td></tr>
      <tr><td>.section--alt</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Alternate background (bg-alt token)</td></tr>
      <tr><td>.section--blue</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Blue background with light text</td></tr>
      <tr><td>.section--opensource</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Open-source section theme</td></tr>
      <tr><td>.section--providers</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Providers section theme</td></tr>
      <tr><td>.section--usecases</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Use-cases section theme</td></tr>
      <tr><td>.section--why</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Why section theme</td></tr>
      <tr><td>.section__tag</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Small pill label above the title</td></tr>
      <tr><td>.section__tag--blue</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Blue color variant of the tag</td></tr>
      <tr><td>.section__tag--accent</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Accent color variant of the tag</td></tr>
      <tr><td>.section__title</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Main section heading</td></tr>
      <tr><td>.section__title--blue</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Blue color variant of the title</td></tr>
      <tr><td>.section__subtitle</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Supporting paragraph below the title</td></tr>
      <tr><td>.section__body</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Main content area of the section</td></tr>
      <tr><td>.section__body--blue</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Blue color variant of the body text</td></tr>
      <tr><td>.section__badge</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Decorative badge element inside a section</td></tr>
      <tr><td>.section__badge--accent</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Accent color variant of the badge</td></tr>
      <tr><td>.section__badge--teal</td><td><span class="docs-tag docs-tag--modifier">modifier</span></td><td style="color:var(--docs-text-muted)">Teal color variant of the badge</td></tr>
      <tr><td>.section__list</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Styled list inside the section body</td></tr>
      <tr><td>.section__hero-visual</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Hero visual slot for images or illustrations</td></tr>
    </tbody>
  </table>
</DocsLayout>
