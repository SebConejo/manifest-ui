---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Video Modal">
  <h1>Video Modal <span class="docs-tag">Modals &amp; Overlays</span></h1>
  <p class="docs-lead">Fullscreen video modal with backdrop. Contains an iframe player.</p>
  <h2>Preview</h2>
  <div class="docs-preview">
    <link rel="stylesheet" href="/styles/manifest.css" />
    <div class="video-modal" hidden>
      <div class="video-modal__backdrop"></div>
      <div class="video-modal__content">
        <button class="video-modal__close">×</button>
        <div class="video-modal__player">
          <iframe src="https://www.youtube.com/embed/..." allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
  <h2>HTML</h2>
  <div class="docs-code"><pre>{`<div class="video-modal" hidden>
  <div class="video-modal__backdrop"></div>
  <div class="video-modal__content">
    <button class="video-modal__close">×</button>
    <div class="video-modal__player">
      <iframe src="https://www.youtube.com/embed/..." allowfullscreen></iframe>
    </div>
  </div>
</div>`}</pre></div>
  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.video-modal</td><td><span class="docs-tag">base</span></td><td>Root fullscreen video modal container.</td></tr>
      <tr><td>.video-modal[hidden]</td><td><span class="docs-tag docs-tag--state">state</span></td><td>Hides the video modal.</td></tr>
      <tr><td>.video-modal__backdrop</td><td><span class="docs-tag docs-tag--element">element</span></td><td>Dark backdrop behind the video content.</td></tr>
      <tr><td>.video-modal__content</td><td><span class="docs-tag docs-tag--element">element</span></td><td>Centered content wrapper holding the close button and player.</td></tr>
      <tr><td>.video-modal__close</td><td><span class="docs-tag docs-tag--element">element</span></td><td>Close button.</td></tr>
      <tr><td>.video-modal__close:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td>Hover state for the close button.</td></tr>
      <tr><td>.video-modal__player</td><td><span class="docs-tag docs-tag--element">element</span></td><td>Player wrapper that sizes the iframe.</td></tr>
      <tr><td>.video-modal__player iframe</td><td><span class="docs-tag docs-tag--element">element</span></td><td>Embedded iframe video player.</td></tr>
    </tbody>
  </table>
</DocsLayout>
