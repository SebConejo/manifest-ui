---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout title="Related Card">
  <h1>Related Card <span class="docs-tag">Other</span></h1>
  <p class="docs-lead">Small card linking to a related provider or agent. Shows logo and name.</p>

  <h2>Preview</h2>
  <div class="docs-preview">
    
    <a class="related-card" href="#">
      <img class="related-card__logo" src="https://placehold.co/32x32" alt="OpenAI" />
      <span class="related-card__name">OpenAI</span>
    </a>
  </div>

  <h2>HTML</h2>
  <div class="docs-code">
    <pre>&lt;a class="related-card" href="#"&gt;
  &lt;img class="related-card__logo" src="..." alt="OpenAI" /&gt;
  &lt;span class="related-card__name"&gt;OpenAI&lt;/span&gt;
&lt;/a&gt;</pre>
  </div>

  <h2>Class reference</h2>
  <table class="docs-table">
    <thead><tr><th>Class</th><th>Type</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td>.related-card</td><td><span class="docs-tag">base</span></td><td style="color:var(--docs-text-muted)">Card link wrapper</td></tr>
      <tr><td>.related-card:hover</td><td><span class="docs-tag docs-tag--state">state</span></td><td style="color:var(--docs-text-muted)">Hover state of the card</td></tr>
      <tr><td>.related-card__logo</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Provider or agent logo image</td></tr>
      <tr><td>.related-card__name</td><td><span class="docs-tag docs-tag--element">element</span></td><td style="color:var(--docs-text-muted)">Provider or agent name label</td></tr>
    </tbody>
  </table>
</DocsLayout>
